PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
# REQUIRED in production: cryptographically random string (>= 32 characters)
JWT_SECRET=replace_with_a_cryptographically_strong_random_secret_min_32_chars
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:4200
# Comma-separated extra allowed origins (e.g. https://skillbridge.app,capacitor://localhost)
CORS_ALLOWED_ORIGINS=
# Single consistent Gemini API Key variable (optional; falls back to rule-based engine when blank)
GEMINI_API_KEY=
USE_MEMORY_DB=false
NODE_ENV=development
ML_SERVICE_URL=http://127.0.0.1:8000
