{
  "appId": "com.skillbridge.career",
  "appName": "SkillBridge",
  "webDir": "dist/frontend/browser",
  "bundledWebRuntime": false,
  "backgroundColor": "#0B1020",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0B1020",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B1020"
    }
  }
}
